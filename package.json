{
  "name": "claude-session-restore",
  "version": "0.1.0",
  "description": "Restore your Claude Code sessions in VSCode after a shutdown, and manage every chat across every project.",
  "type": "module",
  "bin": {
    "csr": "./bin/csr.js"
  },
  "scripts": {
    "test": "TZ=Australia/Adelaide node --test test/*.test.js",
    "daemon": "node src/recorder/daemon.js",
    "gui": "electrobun build --env=stable"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "electrobun": "^1.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/akv2011/claude-session-restore.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "vscode",
    "session",
    "restore",
    "cli",
    "macos",
    "electrobun"
  ],
  "author": "akv2011"
}
